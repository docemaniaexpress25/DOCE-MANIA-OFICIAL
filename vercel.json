{
  "crons": [
    {
      "path": "/api/notas-sync",
      "schedule": "0 12 * * *"
    },
    {
      "path": "/api/boletos-sync",
      "schedule": "0 10 * * *"
    },
    {
      "path": "/api/boletos-sync/slot2",
      "schedule": "0 16 * * *"
    },
    {
      "path": "/api/boletos-sync/slot3",
      "schedule": "0 22 * * *"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "ALLOWALL" },
        { "key": "X-XSS-Protection", "value": "1; mode=block" }
      ]
    }
  ]
}