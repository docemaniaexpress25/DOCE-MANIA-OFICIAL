{
  "crons": [
    {
      "path": "/api/notas-sync",
      "schedule": "*/5 * * * *"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "ALLOWALL" },
        { "key": "X-XSS-Protection", "value": "1; mode=block" }
      ]
    }
  ]
}